# IncidentIQ Environment Variables

# Groq API Key (get one at https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# Groq Model (recommended: llama-3.1-70b-versatile)
GROQ_MODEL=llama-3.1-70b-versatile

# Server Configuration
PORT=3001
HOST=localhost

# CoCo CLI Mode
# Set to "live" when cortex CLI is installed, "simulation" for demo without CLI
COCO_MODE=simulation

# Snowflake Connection (used when COCO_MODE=live)
SNOWFLAKE_CONNECTION=default
